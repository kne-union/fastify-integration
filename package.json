{
  "name": "@kne/fastify-integration",
  "version": "0.1.2",
  "description": "KNE 子应用集成协议插件：租户级联邦，同时具备上游(host)与下游(guest)两侧能力",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,tests/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "test": "node --test 'tests/*.test.js'"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-integration.git"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "kne",
    "multi-tenant",
    "tenant",
    "federation",
    "integration",
    "openapi",
    "signature",
    "permission",
    "proxy",
    "bff"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-integration/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-integration#readme",
  "peerDependencies": {
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "@kne/fastify-signature": ">=1.0.2",
    "@kne/fastify-tenant": ">=1.0.0-alpha.0",
    "fastify-plugin": ">=5"
  },
  "peerDependenciesMeta": {
    "@kne/fastify-tenant": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@kne/fastify-sequelize": "^3.0.6",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "nodemon": "^3.1.3",
    "prettier": "^3.2.5",
    "sqlite3": "^5.1.7"
  },
  "dependencies": {
    "@fastify/reply-from": "^12.6.5",
    "http-errors": "^2.0.1",
    "lodash": "^4.18.1"
  }
}
